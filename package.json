{
  "name": "tulip-file-explorer",
  "private": true,
  "version": "1.5.0",
  "description": "A modern cross-platform file explorer with glass effect UI",
  "author": "Atish Ak Sharma <atishaksharma@gmail.com> (https://atishakasharma.com/)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "dist": "vite build && electron-builder --win --mac --linux"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.5.0"
  },
  "build": {
    "appId": "com.tulip.fileexplorer",
    "productName": "Tulip File Explorer",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/.cache/**",
      "!**/.git/**",
      "!**/tests/**",
      "!**/docs/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "icon": "build/icons/512x512.png",
      "target": {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "icon": "build/icons/512x512.png",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "atishsharma",
        "repo": "Tulip-File-Explorer",
        "releaseType": "draft"
      }
    ],
    "artifactName": "Tulip-File-Explorer-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12"
  },
  "desktopName": "tulip-file-explorer.desktop"
}
